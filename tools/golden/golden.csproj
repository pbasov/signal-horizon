<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway golden-master generator for the Tauri/TS spike.
    It compiles the REAL, UNMODIFIED sim truth-layer sources by <Compile Include>
    (linking, not copying) so the emitted Earth@J2000 vector is the genuine C#
    output, then pins it in the TypeScript Vitest suite. Build artifacts land only
    under prototype-tauri/tools/golden/{bin,obj}; nothing is written into the Godot
    project. `dotnet run` needs no NuGet restore (System.Text.Json is in the
    net8.0 shared framework), so it works fully offline.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SignalHorizon.Golden</RootNamespace>
    <AssemblyName>golden</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="/home/basov/Games/Godot/galaxy-link/SignalHorizon.Sim/Ephemeris.cs" Link="sim/Ephemeris.cs" />
    <Compile Include="/home/basov/Games/Godot/galaxy-link/SignalHorizon.Sim/OrbitalBody.cs" Link="sim/OrbitalBody.cs" />
  </ItemGroup>

</Project>
